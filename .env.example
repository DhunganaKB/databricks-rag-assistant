# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# In Databricks Apps these values come from app.yaml and the app's resources instead.

# --- Databricks connection (local only; Databricks Apps authenticates as the app's service principal)
DATABRICKS_HOST=https://adb-7405616448132971.11.azuredatabricks.net
DATABRICKS_TOKEN=            # personal access token; or leave empty and use DATABRICKS_CONFIG_PROFILE
# DATABRICKS_CONFIG_PROFILE=  # alternative: a profile from ~/.databrickscfg

# --- Data produced by the ETL project (gold layer)
VS_INDEX=steampunk.dev_kbdhunga_rag_gold.chunks_index
CITATIONS_VIEW=steampunk.dev_kbdhunga_rag_gold.citation_locations
DOCUMENTS_VIEW=steampunk.dev_kbdhunga_rag_gold.rag_documents
PAGE_IMAGE_ROOT=/Volumes/steampunk/dev_kbdhunga_rag_silver/page_images/
SQL_WAREHOUSE_ID=e21be0a5a64a99a6

# --- Models (Databricks Foundation Model endpoints)
LLM_ENDPOINT=databricks-claude-sonnet-5-5
HELPER_LLM_ENDPOINT=databricks-claude-haiku-5-5

# --- Conversation history
HISTORY_TURNS=5              # last N question/answer pairs sent to the model
STORE_BACKEND=sqlite         # sqlite (local) | postgres (Lakebase in Databricks)
SQLITE_PATH=.data/rag_app.db
# LAKEBASE_INSTANCE=          # postgres backend only
# PG_SCHEMA=rag_app

# --- Retrieval / generation
NUM_RESULTS=8
MAX_CHUNKS_PER_DOC=4
MAX_ANSWER_TOKENS=900

# --- Local identity (Databricks Apps provides X-Forwarded-Email instead)
LOCAL_USER_ID=local.developer@example.com
